# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEVELOPMENT_ANON_KEY

# Server-only Supabase access. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEVELOPMENT_SERVICE_ROLE_KEY

# Owner notification email
OWNER_NOTIFICATION_EMAIL=owner@example.com
RESEND_API_KEY=YOUR_DEVELOPMENT_RESEND_API_KEY
RESEND_FROM_EMAIL=Mercurius <notifications@YOUR_VERIFIED_DEVELOPMENT_DOMAIN>

# Supabase Edge Function configuration (set in Supabase, not Vercel browser env)
SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_DEVELOPMENT_ANON_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_TEST_WEBHOOK_SECRET
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
