# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEVELOPMENT_ANON_KEY

# Server-only Supabase access. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEVELOPMENT_SERVICE_ROLE_KEY

# Dedicated vendor-upload grant signing. Generate at least 32 random characters.
# Increment the version when rotating the secret; existing grants then expire.
VENDOR_UPLOAD_HMAC_SECRET=YOUR_DEVELOPMENT_VENDOR_UPLOAD_HMAC_SECRET
VENDOR_UPLOAD_HMAC_VERSION=v1

# Owner notification email (vendor applications, contact form, renewal documents).
# OWNER_NOTIFICATION_EMAIL overrides the owner-confirmed fallback recipient in code.
# RESEND_FROM_EMAIL must use a domain verified in Resend (SPF/DKIM).
OWNER_NOTIFICATION_EMAIL=owner@example.com
RESEND_API_KEY=YOUR_DEVELOPMENT_RESEND_API_KEY
RESEND_FROM_EMAIL=Mercurius <notifications@YOUR_VERIFIED_DEVELOPMENT_DOMAIN>

# Supabase Edge Function configuration (set in Supabase, not Vercel browser env)
SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_DEVELOPMENT_ANON_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_TEST_WEBHOOK_SECRET
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local component catalog only; leave disabled in deployed environments.
MDS_CATALOG_ENABLED=0
## Phase 5 Edge execution stays disabled unless explicitly set to test.
## Only sk_test_ Stripe keys are accepted by the new money handlers.
## Do not configure live money or an ACH API; bank ACH is owner-operated.
MERCURIUS_MONEY_MODE=

# Lifecycle Edge processing: false by default; true only for approved isolated tests.
# This does not register or enable Cron. Production activation requires a separate gate.
JOB_LIFECYCLE_ENABLED=false
# Provision a real value in the server-side secret store before enabling.
JOB_WORKER_SECRET=

# Provider invitation dispatch is disabled by default. local-test accepts only
# loopback Supabase (or local kong) and loopback SITE_URL; use the local mail sink.
# hosted sends real invitations and is armed only by explicit owner authorization
# (see governance/PHASE-5-HOSTED-INVITATION-DELIVERY.md). It requires both pins below
# to match the running SUPABASE_URL (https://<ref>.supabase.co) and SITE_URL origin.
MERCURIUS_INVITATION_MODE=
# Hosted pins: the 20-character Supabase project ref and the HTTPS site origin
# (no trailing slash). Leave empty outside an authorized hosted environment.
MERCURIUS_INVITATION_PROJECT_REF=
MERCURIUS_INVITATION_SITE_ORIGIN=
