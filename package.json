{
  "name": "mercurius-marketplace-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:db": "supabase test db",
    "db:reset": "supabase db reset --local",
    "db:seed:generate": "node scripts/generate-reference-seed.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "inventory:backend": "node scripts/inventory-backend-references.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run scan:secrets && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:a11y": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
